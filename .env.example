# QuantBot — copy to .env and fill values. Never commit .env.

# Mode: paper | live (paper trading must use separate credentials/URLs)
QUANTBOT_MODE=paper

# --- LIVE TRADING SAFETY LOCK ------------------------------------------------
# Real money is OFF unless ALL of these hold:
#   1) QUANTBOT_MODE=live
#   2) LIVE_TRADING_ARMED=I_UNDERSTAND_THIS_USES_REAL_MONEY (exact phrase)
#   3) PROMOTION_GATES_PASSED=1
#   4) LIVE_MAX_NOTIONAL_PER_TRADE > 0
# Default: empty / 0 -> bot stays in paper / shadow mode regardless of QUANTBOT_MODE.
LIVE_TRADING_ARMED=
PROMOTION_GATES_PASSED=0
LIVE_MAX_NOTIONAL_PER_TRADE=0

# --- One-shot startup cleanup --------------------------------------------------
# Recommended first boot after Sprint 13: clean ghost SQLite positions only,
# DO NOT touch Alpaca paper account state. After one boot set WIPE_GHOST_POSITIONS=0.
#   RESET_PAPER_ON_STARTUP=0
#   WIPE_GHOST_POSITIONS=1
# RESET_PAPER_ON_STARTUP=1 wipes paper trades/signals/portfolio_state and
# decision/scalp tables — only use that on a fresh-paper-account deploy.
RESET_PAPER_ON_STARTUP=0
WIPE_GHOST_POSITIONS=0

# --- Crypto micro-scalping ----------------------------------------------------
# Strategy tuning now lives in SQLite runtime config tables:
#   strategy_parameters, strategy_runtime_state, strategy_versions.
# Keep env vars minimal: mode + emergency overrides only.
SCALP_MODE=paper_crypto
SCALP_ALLOW_LIVE=0
AGGRESSIVE_SCALP_ENABLED=1
AGGRESSIVE_SCALP_FORCE_DISABLED=0
AGGRESSIVE_SCALP_HARD_MAX_DAILY_LOSS=2.00
AGGRESSIVE_SCALP_HARD_MAX_NOTIONAL=5.00

# --- Promotion gates (paper -> live readiness) -------------------------------
# Override via env to simulate / accelerate gates in dev.
# PROMOTION_MIN_PAPER_HOURS=168
# PROMOTION_MIN_CLOSED_TRADES=30
# PROMOTION_MIN_EXPECTANCY=0.0005
# PROMOTION_MAX_DRAWDOWN_PCT=0.10
# PROMOTION_MAX_RECENT_PRICE_ERRORS=5
# PROMOTION_MAX_RECENT_DB_LOCKS=5
# PROMOTION_RECENT_WINDOW_HOURS=24
# Acknowledge manual tests:
# KILL_SWITCH_TESTED=0
# DAILY_LOSS_LIMITER_TESTED=0

# Alpaca (stocks + crypto) — https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=
# Comma-separated tickers for: python main.py --quotes
# ALPACA_QUOTE_SYMBOLS=AAPL,TSLA
# CRYPTO_QUOTE_SYMBOLS=BTC/USD,ETH/USD,SOL/USD

# Sprint 7 — Reddit (PRAW) + RSS + FinBERT (free sentiment)
# https://www.reddit.com/prefs/apps — create a “script”/read-only app for client id/secret
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=QuantBot/1.0 (paper trading research)
# REDDIT_SUBREDDITS=stocks+investing+StockMarket
# Comma-separated extra RSS URLs (optional; Yahoo headlines are always fetched per symbol)
# RSS_EXTRA_FEEDS=
# FINBERT_MODEL=ProsusAI/finbert
# SENTIMENT_MAX_TEXTS=24

# Alpha Vantage — economic calendar (free tier)
ALPHA_VANTAGE_API_KEY=

# Telegram — alerts (Sprint 8+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite — optional; default is data/quantbot.sqlite3 under the app root (portable / Railway-friendly)
# QUANTBOT_DB_PATH=data/quantbot.sqlite3
# Railway (shared worker + web): mount a volume and point both services at the same file, e.g.
# QUANTBOT_DB_PATH=/data/quantbot.sqlite3

# Logging
LOG_LEVEL=INFO

# Capital & risk — set STARTING_BALANCE to your funded amount (e.g. 100). Live sizing reads
# Alpaca account equity each cycle; this value drives kill-switch baseline + dashboard PnL %.
# STARTING_BALANCE=100
# KILL_SWITCH_PCT=0.15
# MAX_PER_TRADE_RISK_PCT=0.02
# MAX_SINGLE_ASSET_PCT=0.10
# MAX_PORTFOLIO_DEPLOYED_PCT=0.60
# TARGET_CRYPTO_ALLOCATION=0.50
# COOLDOWN_MINUTES_AFTER_STOP=30

# RL nudge — after enough closed round-trips, SQLite thresholds (buy/sell/crypto_buy) adjust from win rate
# RL_NUDGE_ENABLED=1
# RL_NUDGE_MIN_TRADES=30

# When Alpaca equity is below EQUITY_SCALE_REF_USD, max position % is scaled up (capped at
# SMALL_ACCOUNT_POSITION_BOOST_MAX×). Set EQUITY_SCALE_REF_USD=0 to disable.
# EQUITY_SCALE_REF_USD=1000
# SMALL_ACCOUNT_POSITION_BOOST_MAX=2.5

# Cross-asset spillover (lead–lag from daily returns; offline: python -m training.cross_asset_tune)
# CROSS_ASSET_ENABLED=0
# CROSS_ASSET_EDGES_PATH=persist/cross_asset_edges.json
# CROSS_ASSET_SCORE_GAIN=0.12
# CROSS_ASSET_RET_SCALE=0.015
# CROSS_ASSET_DELTA_CLAMP=0.22
#
# Weekly tune (Railway Cron second service): same list you want in the graph — NOT auto-synced
# to the trade universe; copy tickers from your stock list / scanner settings into this env.
# CROSS_ASSET_TUNE_SYMBOLS=SPY,QQQ,IWM,DIA,XLF,XLK
# CROSS_ASSET_TUNE_DAYS=252
# CROSS_ASSET_TUNE_MIN_RHO=0.38
# CROSS_ASSET_TUNE_OUTPUT=   # empty = PERSIST_DIR/cross_asset_edges.json
# Cron start (Linux): bash scripts/weekly_cross_asset_tune.sh
# Schedule example (UTC): Friday 21:05 → 5 21 * * 5  |  Sunday 02:00 → 0 2 * * 0
# Mount the SAME volume at QUANTBOT_PERSIST_DIR (/app/persist) on both worker and cron.

# Backtest / offline tuning (see: python -m training.offline_tune --help)
# BACKTEST_BUY_THRESHOLD=0.035
# BACKTEST_SELL_THRESHOLD=-0.06
# BACKTEST_EXIT_LONG_SCORE=0.128

# Paper ledger defaults (omit to mirror STARTING_BALANCE)
# PAPER_STOCKS_STARTING_CASH=100
# PAPER_CRYPTO_STARTING_CASH=100

# Dashboard admin (POST /api/config, reset-db, sync-alpaca)
# DASHBOARD_SECRET=

# Health: max age (seconds) of latest portfolio_state snapshot before /health returns 503
# HEALTH_MAX_SNAPSHOT_AGE_SEC=1800

# Sprint 8 — Flask dashboard (`python main.py --dashboard`)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
