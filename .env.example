# QuantBot — local / Railway env template (secrets: set in Railway UI or local .env)
# Operational toggles: prefer dashboard Config tab (bot_config) when available.

# --- Secrets (required for broker) ---
ALPACA_API_KEY=<alpaca-key>
ALPACA_SECRET_KEY=<alpaca-secret>

# --- Optional secrets ---
GEMINI_API_KEY=<optional>
TELEGRAM_BOT_TOKEN=<optional>
TELEGRAM_CHAT_ID=<optional>
TELEGRAM_MOMO_ALLOWED_CHAT_ID=<optional>
RAILWAY_PROJECT_TOKEN=<optional>
DASHBOARD_SECRET=<optional>

# --- Mode / paths ---
MODE=paper
QUANTBOT_MODE=paper
ALPACA_BASE_URL=https://paper-api.alpaca.markets
QUANTBOT_PERSIST_DIR=./persist
LOG_LEVEL=INFO

# --- Live safety (keep disabled for paper) ---
LIVE_TRADING_ARMED=
PROMOTION_GATES_PASSED=0
LIVE_MAX_NOTIONAL_PER_TRADE=0

# --- Fast loop (execution stays off until operator enables via bot_config) ---
# crypto_fast_loop_enabled=1
# crypto_fast_loop_execute_orders=0

# Generate full template: GET /api/config/railway-env-template
