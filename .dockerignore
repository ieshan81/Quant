# Strict build context for Railway (Nixpacks respects this file).
# Python package sources live in data/*.py — do not exclude them (see negation below).

.git
.github
.venv
venv
env
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
node_modules
dist
build
htmlcov
coverage
.coverage

logs
logs/
exports
exports/
backups
backups/
persist
persist/
quantbot
quantbot/

# Runtime under data/ (package data/*.py must ship — negation below)
data/**
!data/
!data/**
!data/**/*.py

*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.log
.env
.env.*

.DS_Store
Thumbs.db
*.tar
*.tar.gz
*.zip
*.gz
*.whl

# Dev / docs / tests (not needed in production image)
tests
tests/
docs
docs/
scripts
scripts/
tools
tools/
backtesting
backtesting/
.cursor
.claude
.code-review-graph
.obsidian
.cache
**/.cache
models
models/
*.md
!README.md

