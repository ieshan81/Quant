backups/
persist
persist/
quantbot
quantbot/

# Runtime under data/ (package data/*.py must ship — negation below)
data/**
!data/
!data/**
!data/**/*.py

# Python packages required at runtime (explicit negation — do not rely on absence from ignore list)
!backtesting/
!backtesting/**
!backtesting/**/*.py
!core/
!core/**
!core/**/*.py
!execution/
!execution/**
!execution/**/*.py
